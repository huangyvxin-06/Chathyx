# Chathyx 环境变量配置
# 本文件包含数据库密码，禁止提交到 Git 或对外分享。
# 程序启动时会由 db.py 自动读取本文件；已在系统环境变量中设置的值不会被覆盖。
# 注意：不要在配置行末尾写行内注释，需单独成行。

CHATHYX_DB_HOST=127.0.0.1
CHATHYX_DB_PORT=3306
# 数据库用户名，一般是 root
CHATHYX_DB_USER=@mysqlusername
CHATHYX_DB_NAME=chathyx
# 数据库密码
CHATHYX_DB_PASSWORD=@yourpassword

# Web 管理后台（admin_server.py）管理员 admin 的登录密码，可自行修改
CHATHYX_ADMIN_PASSWORD=admin123
