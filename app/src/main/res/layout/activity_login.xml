<?xml version="1.0" encoding="utf-8"?>

<!-- 根布局：负责整个页面的背景 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".LoginActivity">

    <!-- 滚动容器：小屏手机可以上下滚动 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <!-- 页面外层垂直布局 -->
        <LinearLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- 聊天 Logo -->
            <ImageView
                android:id="@+id/ivChatLogo"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_chat_logo"
                android:background="@drawable/bg_logo_circle"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:contentDescription="Chathyx Logo" />

            <!-- 应用名称 -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chathyx"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <!-- BETA 版本标签 -->
            <TextView
                android:id="@+id/tvBeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="BETA"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_beta" />

            <!-- 应用标语 -->
            <TextView
                android:id="@+id/tvSlogan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Chat with hyx"
                android:textColor="#E5E7FF"
                android:textSize="16sp" />

            <!-- 登录卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:contentPadding="24dp">

                <!-- 卡片内部垂直布局 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 登录标题 -->
                    <TextView
                        android:id="@+id/tvLoginTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="center"
                        android:text="Welcome to Chathyx"
                        android:textColor="#19334A"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- 账号输入框 -->
                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/input_bg"
                        android:hint="请输入账号"
                        android:inputType="text"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="#19334A"
                        android:textColorHint="#8A9BA8"
                        android:textSize="16sp"
                        android:drawableStart="@drawable/ic_user"
                        android:drawablePadding="12dp" />

                    <!-- 密码输入框 -->
                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/input_bg"
                        android:hint="请输入密码"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="#19334A"
                        android:textColorHint="#8A9BA8"
                        android:textSize="16sp"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="12dp" />

                    <!-- 登录按钮 -->
                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:text="登录"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#168BCC"
                        android:stateListAnimator="@null" />

                    <!-- 改为注册提示 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="20dp">

                        <!-- 提示文字 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="没有账号？"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <!-- 注册文字和跳转 -->
                        <TextView
                            android:id="@+id/tvGoRegister"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="立即注册"
                            android:textColor="#168BCC"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
